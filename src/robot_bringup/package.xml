<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.0.0</version>
  <description>Whole-body bringup: launches Quest VR reader, dual-arm RC control and AMR chassis control in one launch file.</description>
  <maintainer email="kevin@todo.todo">kevin</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>quest_vr</exec_depend>
  <exec_depend>jaka_driver</exec_depend>
  <exec_depend>sr_amr_control</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
